simid     SingleSP 
ncell     1         1         1                 System size
BC        0         0         0                 Boundary conditions (0=vacuum,P=periodic)
cell      1.00000   0.00000   0.00000
          0.00000   1.00000   0.00000
          0.00000   0.00000   1.00000
Sym       0                                     Symmetry of lattice (0 for no, 1 for cubic, 2 for 2d cubic, 3 for hexagonal)

posfile    ./posfile
exchange   ./jfile
momfile    ./momfile
anisotropy ./kfile
do_prnstruct 1                                  Print lattice structure (0=no, 1=yes)

Mensemble 1                                     Number of samples in ensemble averaging
initmag   3                                     (1=random, 2=cone, 3=spec., 4=file)
restartfile ./start.0

ip_mode   N                                     Initial phase parameters
ip_nphase 1
1000 0.0 1e-14 1.0
# ip_hfield 0.0 0.16 0.0 

mode      S                                     S=SD, M=MC
temp      0.0000                                Measurement phase parameters
damping   0.01000                               --
Nstep     100000                                 --
timestep  1.000e-14                             --
# hfield 0.0 0.16 0.0                             #B_app

do_avrg   Y                                     Measure averages
avrg_step 100 

do_tottraj Y                                    Measure moments
tottraj_step       100
tottraj_buff       10                           time step, buffer size

do_cumu Y

do_she Y
she_angle 0.20
jdens 0.0 5.0e12 0.0 
she_n_vec 0.0 0.0 1.0
alat 2e-9
thick_ferro 0.5e-9
adibeta 0.0

do_prn_beff Y
prn_beff Y
beff_step 100

do_prn_spin_torques Y       # Print spin torques
spin_torques_step    100    # print every 100 steps
spin_torques_buff    10     # buffer 10 steps before writing

do_prn_torques Y       # Print total torques
torques_step    100    # print every 100 steps
torques_buff    10     # buffer 10 steps before writing

real_time_measure Y

