simid     HeisWire                              System name
ncell     100       1         1                 System size (in terms of unit cells)
BC        0         0         0                 Boundary conditions (0=vacuum,P=periodic)
cell      1.00000   0.00000   0.00000
          0.00000   1.00000   0.00000
          0.00000   0.00000   1.00000
Sym       1                                     Symmetry of lattice (0 for no, 1 for cubic, 2 for 2d cubic, 3 for hexagonal)

posfile   ./posfile                             Position file
exchange  ./jfile                               Exchange file
momfile   ./momfile                             Moment file
anisotropy ./kfile
do_prnstruct 1                                  Print lattice structure (0=no, 1=yes)
SDEalgh 5 


Mensemble 1                                     Number of samples in ensemble averaging
Initmag   4                                     (1=random, 2=cone, 3=spec., 4=file)
restartfile ./start.af

ip_mode   S                                     Initial phase parameters
ip_nphase 1
20000 1.0e-3 1e-15 4.0

mode      S                                     S=SD, M=MC
temp      0.0e-3                                Measurement phase parameters
damping   0.1000                                --
Nstep     50000                                 --
timestep  1.000e-15                             --

do_avrg   Y                                     Measure averages
avrg_step 100 

do_tottraj Y                                    Measure moments
tottraj_step       100
tottraj_buff       10                           time step, buffer size

plotenergy 1
do_cumu Y

stt A
!do_she Y
thick_ferro 1e-9
jdens  5e12 0 0 
adibeta 0.1
alat 2.0e-10

do_prn_spin_torques Y
spin_torques_step    100    # print every 100 steps
spin_torques_buff    10     # buffer 10 steps before writing

do_prn_beff Y
beff_step 100
beff_buff 10

do_prn_torques Y
torques_step    100    # print every 100 steps
torques_buff    10     # buffer 10 steps before writing

